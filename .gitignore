# =============================================================================
# Secrets and per-machine config — NEVER commit
# =============================================================================

# Info.plist is now COMMITTED so the project builds with no `cp` step and ships
# with the hosted OpenAI proxy URL baked in. It carries NO secrets — the real
# API keys live only as Cloudflare Worker secrets, never in this file. The
# AnthropicAPIKey field stays empty here. (Info.plist.example is kept as docs.)

# Cloudflare Worker dev secrets. Committed template is .dev.vars.example.
worker/.dev.vars
!worker/.dev.vars.example
worker/.env
worker/.env.*
!worker/.env.example

# Generic env files at the repo root.
.env
.env.*
!.env.example

# =============================================================================
# Build artefacts and tool caches
# =============================================================================

# Worker / wrangler
worker/node_modules/
worker/.wrangler/
worker/package-lock*.json

# Xcode (build outputs, per-user state, derived data)
macos-app/build/
macos-app/DerivedData/
macos-app/**/xcuserdata/
macos-app/**/*.xcuserdatad/
macos-app/**/*.xcuserstate
macos-app/**/*.xcscheme

# Swift Package Manager
.swiftpm/
Packages/

# =============================================================================
# OS / editor cruft
# =============================================================================

.DS_Store
*.swp
*.swo
.vscode/
.idea/
</content>
